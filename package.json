{
  "name": "cosmostock",
  "version": "1.0.0",
  "description": "CosmoStock — ระบบจัดการคลังสินค้าเครื่องสำอาง (Node.js + PostgreSQL)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "reset": "node server.js --reset",
    "superadmin": "node server.js --reset-superadmin",
    "import-sqlite": "node --disable-warning=ExperimentalWarning scripts/import-sqlite.mjs",
    "backup": "bash deploy/backup.sh"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "pg": "^8.23.1"
  }
}
